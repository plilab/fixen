module ReducedProduct.IntervalAnalysis where

import ReducedProduct.Common
import ReducedProduct.Interval

rel stateBefore: Nat, IState

-- statement
rel var:    Nat, String             -- variable declaration:   (var X)^l
rel assign: Nat, String,  Expr      -- variable assignment:    (X := E)^l
rel cond:   Nat, Expr, Nat, Nat     -- conditional expression  (E_{consequent;alternative})^l

-- other cfg edges
rel seq:    Nat, Nat

-- Initial facts (just intializing our DB)

rule assignInit:
  assign l x e
  |- stateBefore l (emptyI 0) -- the argument to empty is ignored, see the comment in Dataflow.Sign

rule condInit:
  cond l e jlt jlf
  |- stateBefore l (emptyI 0)

rule varInit:
  var l x
  ---------------------------------
  |- stateBefore l (emptyI 0)

-- Actual transfer functions.

rule assignStep:
  assign lAssign x e, stateBefore lAssign stAssign, seq lAssign lAfter, stateBefore lAfter stAfter
  -----------------------------------------------------------------------------------------------
  |- stateBefore lAfter (joinI (insertI x (evalI e stAssign) stAssign) stAfter)


rule evalCondTrue:
  stateBefore lcond stc, cond lcond e jlt jlf, stateBefore jlt stt, if leq BTrue (evaluateConditional e stc)
  -----------------------------------------------------------------------------------------------------
  |- stateBefore jlt (joinI (narrowConditionalI e stc) stt)

rule evalCondFalse:
  stateBefore lcond stc, cond lcond e jlt jlf, stateBefore jlf stf, if leq BFalse (evaluateConditional e stc)
  -----------------------------------------------------------------------------------------------------
  |- stateBefore jlf (joinI (narrowConditionalIFalse e stc) stf)


query stateBefore as stateBefore  +

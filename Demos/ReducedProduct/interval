module ReducedProduct.IntervalAnalysis where

import ReducedProduct.Interval

rel stateBefore: Nat, State

-- statement
rel var:    Nat, String             -- variable declaration:   (var X)^l
rel assign: Nat, String,  Expr      -- variable assignment:    (X := E)^l
rel cond:   Nat, Expr, Nat, Nat     -- conditional expression  (E_{consequent;alternative})^l
rel phi:    Nat                     -- a phi node (see static single assignment form)

-- other cfg edges
rel seq:    Nat, Nat

-- Initial facts (just intializing our DB)
rule varInit:
  var l x
  ---------------------------------
  |- stateBefore l (singleton x Bot)

rule assignInit:
  assign l x e
  |- stateBefore l (empty 0) -- the argument to empty is ignored, see the comment in Dataflow.Sign

rule condInit:
  cond l e jlt jlf
  |- stateBefore l (empty 0)

rule phiInit:
  phi l
  |- stateBefore l (empty 0) -- the argument to empty is ignored, see the comment in Dataflow.Sign

-- Actual transfer functions.

rule assignStep:
  seq lAssign lAfter, assign lAssign x e, stateBefore lAfter stA, stateBefore lAssign stBefore
  --------------------------------------------------------------------------------------------
  |- stateBefore lAfter (join (insert x (eval e stBefore) stBefore) stA)


rule evalCondTrue:
  stateBefore lcond stc, cond lcond e jlt jlf, stateBefore jlt stt, if eq (evaluateConditional e stc) True
  -----------------------------------------------------------------------------------------------------
  |- stateBefore jlt (join (narrowConditional e stc) stt)

rule evalCondFalse:
  stateBefore lcond stc, cond lcond e jlt jlf, stateBefore jlf stf, if eq (evaluateConditional e stc) False
  -----------------------------------------------------------------------------------------------------
  |- stateBefore jlf (join (narrowConditionalFalse e stc) stf)


rule seqStep: 
  seq l1 l2, stateBefore l1 st1, stateBefore l2 st2 
  -----------------------------------------------
  |- stateBefore l2 (join st2 st1)


query stateBefore as stateBefore - +
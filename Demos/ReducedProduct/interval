module ReducedProduct.IntervalAnalysis where

import ReducedProduct.Interval


-- rel state: Nat, String, Sign, or
-- type State = Map String Sign
rel stateAfter: Nat, State
-- statement
rel var:    Nat, String             -- variable declaration:   (var X)^l
rel assign: Nat, String,  Expr      -- variable assignment:    (X := E)^l
rel cond:   Nat, Expr, Nat, Nat          -- conditional expression  (E_{consequent;alternative})^l
rel condVal: Nat, BBool              -- conditional value

-- cfg
rel seq:    Nat, Nat            -- edge in the cfg

rule varInit:
  var l x
  ---------------------------------
  |- stateAfter l (singleton x Bot)

rule assignInit:
  assign l x e
  |- stateAfter l (empty 0) -- the argument to empty is ignored, see the comment in Dataflow.Sign

rule condInit:
  cond l e jlt jlf
  |- stateAfter l (empty 0)

rule assignStep:
  stateAfter l st, assign l x e
  ------------------------------------------
  |- stateAfter l (insert x (eval e st) st)

{- I believe the premises can be simplified to:
    `stateAfter lcond st, cond lcond e jlt jlf`
  This is because:
    1) condInit initializes `st`
    2) seqStep propagates the incoming states into `st`
  thus we do not need to explicitly do that propagation in this rule
 -}
rule evalCond:
  seq l0 lcond, stateAfter l0 st, cond lcond e jlt jlf
  ----------------------------------------------------
  |- condVal lcond (evaluateConditional e st)

rule condStepTrue:
  stateAfter l st, stateAfter jlt stt, cond l e jlt jlf, condVal l BTrue
  ---------------------------------------------------------------------
  |- stateAfter jlt (join st stt)

rule condStepFalse:
  stateAfter l st, stateAfter jlf stf, cond l e jlt jlf, condVal l BFalse
  ----------------------------------------------------------------------
  |- stateAfter jlf (join st stf)

{-
  Assuming the flat lattice of booleans:

          BTop
          /  \
      False  True
          \  /
          BBot

  I believe the following is the correct implementation.

rule condStepTrue:
  cond lcond e jlt jlf, stateAfter jlt stt, if leq True (evaluateConditional e st)
  --------------------------------------------------------------------------------
  |- stateAfter jlt (join st stt)

rule condStepFalse:
  cond lcond e jlt jlf, stateAfter jlf stf, if leq False (evaluateConditional e st)
  ---------------------------------------------------------------------------------
  |- stateAfter jlf (join st stf)

  Furthermore, the workaround above whould exhibit the same behavior once the 
  type is changed from current Bool to the flat lattice.
-}

rule seqStep: 
  seq l1 l2, stateAfter l1 st1, stateAfter l2 st2 
  -----------------------------------------------
  |- stateAfter l2 (join st2 st1)


query stateAfter as stateAfter - +
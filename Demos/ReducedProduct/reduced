-- Reduced product of interval and congruence analysis
-- You need to manually copy in FPOP from congruence and interval, as we don't support a module system yet :(
-- In actual production code, we would "import" the rules, and they would be auto-prefixed with the required names.
-- For this example, we just append their "namespace" names behind them, but the power of this technique still holds.
-- Note that other than naming changes, there are NO changes to the rules of interval and congruence analysis respectively.

module ReducedProduct.IntervalAndIsEven where

-- INTERVAL ANALYSIS
import ReducedProduct.Interval

rel stateBeforeInterval: Nat, IState

-- statement
rel var:    Nat, String             -- variable declaration:   (var X)^l
rel assign: Nat, String,  Expr      -- variable assignment:    (X := E)^l
rel cond:   Nat, Expr, Nat, Nat     -- conditional expression  (E_{consequent;alternative})^l
rel phi:    Nat                     -- a phi node (see static single assignment form)

-- other cfg edges
rel seq:    Nat, Nat

-- Initial facts (just intializing our DB)

rule assignInitInterval:
  assign l x e
  |- stateBeforeInterval l (empty' 0) -- the argument to empty is ignored, see the comment in Dataflow.Sign

rule condInitInterval:
  cond l e jlt jlf
  |- stateBeforeInterval l (empty' 0)

rule phiInitInterval:
  phi l
  |- stateBeforeInterval l (empty' 0) -- the argument to empty is ignored, see the comment in Dataflow.Sign

rule varInitInterval:
  var l x
  ---------------------------------
  |- stateBeforeInterval l (empty' 0)

-- Actual transfer functions.

rule assignStepInterval:
  assign lAssign x e, stateBeforeInterval lAssign stAssign, seq lAssign lAfter, stateBeforeInterval lAfter stAfter
  -----------------------------------------------------------------------------------------------
  |- stateBeforeInterval lAfter (join' (insert' x (eval' e stAssign) stAssign) stAfter)


rule evalCondTrueInterval:
  stateBeforeInterval lcond stc, cond lcond e jlt jlf, stateBeforeInterval jlt stt, if leq BTrue (evaluateConditional e stc)
  -----------------------------------------------------------------------------------------------------
  |- stateBeforeInterval jlt (join' (narrowConditional' e stc) stt)

rule evalCondFalseInterval:
  stateBeforeInterval lcond stc, cond lcond e jlt jlf, stateBeforeInterval jlf stf, if leq BFalse (evaluateConditional e stc)
  -----------------------------------------------------------------------------------------------------
  |- stateBeforeInterval jlf (join' (narrowConditionalFalse' e stc) stf)

rule phiStepInterval:
  phi l, stateBeforeInterval l st, seq l lAfter
  --------------------------------------------------------------------------------------------
  |- stateBeforeInterval lAfter st


query stateBeforeInterval as stateBeforeInterval - +

-- ISEVEN ANALYSIS

import ReducedProduct.IsEven

-- NOTE: WE DON'T EVEN NEED TO REDEFINE THE DATA STRUCTURESS!!!!!! WOWW!!!!

rel stateBeforeIsEven: Nat, State

-- Initial facts (just intializing our DB)

rule assignInitIsEven:
  assign l x e
  |- stateBeforeIsEven l (empty 0) -- the argument to empty is ignored, see the comment in Dataflow.Sign

rule condInitIsEven:
  cond l e jlt jlf
  |- stateBeforeIsEven l (empty 0)

rule phiInitIsEven:
  phi l
  |- stateBeforeIsEven l (empty 0) -- the argument to empty is ignored, see the comment in Dataflow.Sign

rule varInitIsEven:
  var l x
  ---------------------------------
  |- stateBeforeIsEven l (empty 0)

-- Actual transfer functions.

rule assignStepIsEven:
  assign lAssign x e, stateBeforeIsEven lAssign stAssign, seq lAssign lAfter, stateBeforeIsEven lAfter stAfter
  -----------------------------------------------------------------------------------------------
  |- stateBeforeIsEven lAfter (join (insert x (eval e stAssign) stAssign) stAfter)


rule evalCondTrueIsEven:
  stateBeforeIsEven lcond stc, cond lcond e jlt jlf, stateBeforeIsEven jlt stt
  -----------------------------------------------------------------------------------------------------
  |- stateBeforeIsEven jlt (join (narrowConditional e stc) stt)

rule evalCondFalseIsEven:
  stateBeforeIsEven lcond stc, cond lcond e jlt jlf, stateBeforeIsEven jlf stf
  -----------------------------------------------------------------------------------------------------
  |- stateBeforeIsEven jlf (join (narrowConditionalFalse e stc) stf)

rule phiStepIsEven:
  phi l, stateBeforeIsEven l st, seq l lAfter
  --------------------------------------------------------------------------------------------
  |- stateBeforeIsEven lAfter st


query stateBeforeIsEven as stateBeforeIsEven - +

-- Finally: this is all the actual additional rules we need for the reduced product.

rel stateBeforeProduct: Nat, IState, State
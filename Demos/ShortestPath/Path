module ShortestPath.ShortestPath where

import ShortestPath.Dist

rel edge   : String, String, Dist
rel distTo : String, Dist
rel start  : String

rule init: start s |- distTo s (DistNat 0)
rule addDist:  distTo v1 d1, edge v1 v2 d2 |- distTo v2 (add d1 d2)

priority:
  leq (add d11 d21) (add d12 d22)
  |- addDist { d1 = d11, d2 = d21 } <= addDist { d1 = d12, d2 = d22 }

query distTo as reachableIn - -
query distTo as distTo - +
query distTo as closerThan + -
query distTo as enumDistTo + +
module ShortestPath.ShortestSelfPath where

import ShortestPath.Dist

rel edge : String, String, Dist
rel path : String, String, Dist
rel selfPath: String, Dist

rule init: edge v1 v2 d |- path v1 v2 d
rule extend: path v1 v2 d1, edge v2 v3 d2 |- path v1 v3 (add d1 d2)
rule selfPath: path v v d |- selfPath v d

query path as path - - +
query selfPath as selfPath - +
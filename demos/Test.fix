module Test where

rel R: String, String

rel T: String, String, String

rule transitive: R b c, R c d |- R b d
rule reflexive: R a _ |- R a a
rule reflexive': R _ y |- R y y


-- rel T: A, B, C

partial ord A where
  type = A
  leq  = aLeq
  mlbs = aMlbs

partial ord C where
  type = String
  leq = cLeq
  mlbs = cMlbs

-- rule identity: T a b c |- T a b c


query r: R + +


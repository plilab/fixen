-- Put this in benchmarks/ShortestPath/FixenNoPriorities.hs
module ShortestPath.FixenNoPriorities where

import Numeric.Natural
import Control.DeepSeq

rel DistTo : Vertex, Dist
rel Edge   : Vertex, Vertex, Dist

lat Dist where
  type = Natural -- the underlying Dist type we declared earlier
  leq  = (>=)
  join = min
  meet = max

-- The main rule.
rule addDist: DistTo a d, Edge a b d'
            |- DistTo b (d + d')

-- interface
query distTo: DistTo + -
query reachableIn: DistTo - +
query distances: DistTo - -

```hs
type Vertex = String

instance NFData Database where
  rnf (Database x y) = rnf (x, y)

instance NFData Fact where
  rnf (DistTo x y) = rnf (x, y)
  rnf (Edge a b c) = rnf (a, b, c)
```

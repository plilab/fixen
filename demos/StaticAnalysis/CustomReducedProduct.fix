-- put this in benchmarks/ReducedProduct/CustomReducedProduct.hs
module ReducedProduct.Custom where

import ReducedProduct.Common

include "Common"


lat StateP where
  type = HashMap String Parity
  leq  = statePLeq
  join = joinP
  meet = meetP

rel StateBeforeP: Label, StateP

lat StateI where
  type = HashMap String Interval
  leq = stateILeq
  join = joinI
  meet = meetI

rel StateBeforeI: Label, StateI


rule assignInitP : Assign __l__ _ _   |- StateBeforeP __l__ HashMap.empty
rule branchInitP   : Branch __l__ _ _ _ |- StateBeforeP __l__ HashMap.empty
rule varInitP    : Var __l__ _        |- StateBeforeP __l__ HashMap.empty
rule assignInitI : Assign __l__ _ _   |- StateBeforeI __l__ HashMap.empty
rule branchInitI : Branch __l__ _ _ _ |- StateBeforeI __l__ HashMap.empty
rule varInitI    : Var __l__ _        |- StateBeforeI __l__ HashMap.empty

-- actual transfer functions
rule assignStepP :
  Assign __l__ __x__ __e__, Seq __l__ __l__', StateBeforeP __l__ __st__
  -----------------------------------------------------------
  |- StateBeforeP __l__' (HashMap.insert __x__ (evalP __e__ __st__) __st__)


-- actual transfer functions
rule assignStepI :
  Assign __l__ __x__ __e__, Seq __l__ __l__', StateBeforeP __l__ __st__, StateBeforeI __l__ __st2__
  -----------------------------------------------------------
  |- StateBeforeI __l__' (reduceInterval (HashMap.insert __x__ (evalP __e__ __st__) __st__) (HashMap.insert __x__ (evalI __e__ __st2__) __st2__))


rule branchTrueP :
  Branch __l__ __e__ __t__ _, StateBeforeP __l__ __st__
  ---------------------------------------------------
  |- StateBeforeP __t__ (refineTP __e__ __st__)


rule branchTrueI:
  Branch __l__ __e__ __t__ _, StateBeforeP __l__ __st__, StateBeforeI __l__ __st2__, if BTrue `leq` (evalCondI __e__ __st2__)
  ----------------------------------------------------------------------------------------------
  |- StateBeforeI __t__ (reduceInterval (refineTP __e__ __st__) (refineTI __e__ __st2__))


rule branchFalseP :
  Branch __l__ __e__ _ __f__, StateBeforeP __l__ __st__
  ---------------------------------------------------
  |- StateBeforeP __f__ (refineFP __e__ __st__)


rule branchFalseI :
  Branch __l__ __e__ _ __f__, StateBeforeP __l__ __st__, StateBeforeI __l__ __st2__, if BFalse `leq` (evalCondI __e__ __st2__)
  -----------------------------------------------------------------------------------------------
  |- StateBeforeI __f__ (reduceInterval (refineFP __e__ __st__) (refineFI __e__ __st2__))

query stateP: StateBeforeP + -

```hs
instance NFData Database where
  rnf (Database a b c d e f) = rnf (a, b, c, d, e, f)

instance NFData Fact where
  rnf (Assign a b c) = rnf (a, b, c)
  rnf (Branch a b c d) = rnf (a, b, c, d)
  rnf (Seq a b) = rnf (a, b)
  rnf (StateBeforeI l m) = rnf (l, m)
  rnf (StateBeforeP l m) = rnf (l, m)
  rnf (Var l s) = rnf (l, s)
```


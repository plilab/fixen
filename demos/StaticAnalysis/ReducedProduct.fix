-- put this in benchmarks/ReducedProduct/FixenNoPriorities.hs
module ReducedProduct.FixenNoPriorities where

include "Parity"
include "Interval"

-- For the time being, we focus only on intervals
-- returns refined interval information from parities
rule reducedExchange : StateBeforeP __l__ __st__, StateBeforeI __l__ __st__' 
                     |- StateBeforeP __l__ __st__, StateBeforeI __l__ (reduceInterval __st__ __st__') 

-- The important bit
phases: [
    * -- everything else
    , { reducedExchange }
  ]

```hs
instance NFData Database where
  rnf (Database a b c d e f) = rnf (a, b, c, d, e, f)

instance NFData Fact where
  rnf (Assign a b c) = rnf (a, b, c)
  rnf (Branch a b c d) = rnf (a, b, c, d)
  rnf (Seq a b) = rnf (a, b)
  rnf (StateBeforeI l m) = rnf (l, m)
  rnf (StateBeforeP l m) = rnf (l, m)
  rnf (Var l s) = rnf (l, s)
```

-- put this in benchmarks/ReducedProduct/Interval.hs
module Main where

import ReducedProduct.Common

lat StateI where
  type = HashMap String Interval
  leq = stateILeq
  join = joinI
  meet = meetI

rel StateBeforeI: Label, StateI

rule assignInitI : Assign __l__ _ _   |- StateBeforeI __l__ HashMap.empty
rule branchInitI : Branch __l__ _ _ _ |- StateBeforeI __l__ HashMap.empty
rule varInitI    : Var __l__ _        |- StateBeforeI __l__ HashMap.empty

-- actual transfer functions
rule assignStepI :
  Assign __l__ __x__ __e__, Seq __l__ __l__', StateBeforeI __l__ __st__
  ---------------------------------------------------------------------
  |- StateBeforeI __l__' (HashMap.insert __x__ (evalI __e__ __st__) __st__)

rule branchTrueI:
  Branch __l__ __e__ __t__ _, StateBeforeI __l__ __st__, if BTrue `leq` (evalCondI __e__ __st__)
  ----------------------------------------------------------------------------------------------
  |- StateBeforeI __t__ (refineTI __e__ __st__)

rule branchFalseI :
  Branch __l__ __e__ _ __f__, StateBeforeI __l__ __st__, if BFalse `leq` (evalCondI __e__ __st__)
  -----------------------------------------------------------------------------------------------
  |- StateBeforeI __f__ (refineFI __e__ __st__)

query stateI: StateBeforeI + -
query stateIs: StateBeforeI - -


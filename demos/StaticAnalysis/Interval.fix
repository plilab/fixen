module StaticAnalysis.Interval where

include "Common"

```hs
joinI :: Void
joinI = undefined
```

partial ord StateI where
  type = HashMap String (Int, Int)
  leq = stateILeq
  mlbs = stateIMlbs

rel StateBeforeI: Label, StateI

rule assignInitI : Assign l _ _   |- StateBeforeI l emptyI
rule condInitI   : Cond l _ _ _ |- StateBeforeI l emptyI
rule varInitI    : Var l _        |- StateBeforeI l emptyI

-- actual transfer functions
rule assignStepI :
  Assign l x e, Seq l l', StateBeforeI l st, StateBeforeI l' st'
  -----------------------------------------------------------
  |- StateBeforeI l' (joinI (insertI x (evalI e st) st) st')

rule evalCondTI :
  Cond l e t _, StateBeforeI l st, StateBeforeI t st'
  ---------------------------------------------------
  |- StateBeforeI t (joinI (refineTI e st) st')

rule evalCondFI :
  Cond l e _ f, StateBeforeI l st, StateBeforeI f st'
  ---------------------------------------------------
  |- StateBeforeI f (join (refineFI e st) st')

query stateI: StateBeforeI - +

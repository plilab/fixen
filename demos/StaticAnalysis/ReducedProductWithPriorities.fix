-- put this in benchmarks/ReducedProduct/FixenWithPriorities.hs
module ReducedProduct.FixenWithPriorities where

include "ReducedProduct"

-- exchanged rules come first
priority:
  True |- assignInitP { } < reducedExchangeP { }
priority:
  True |- branchInitP { } < reducedExchangeP { }
priority:
  True |- varInitP { } < reducedExchangeP { }
priority:
  True |- assignInitI { } < reducedExchangeP { }
priority:
  True |- branchInitI { } < reducedExchangeP { }
priority:
  True |- varInitI { } < reducedExchangeP { }
priority:
  True |- assignInitP { } < reducedExchangeI { }
priority:
  True |- branchInitP { } < reducedExchangeI { }
priority:
  True |- varInitP { } < reducedExchangeI { }
priority:
  True |- assignInitI { } < reducedExchangeI { }
priority:
  True |- branchInitI { } < reducedExchangeI { }
priority:
  True |- varInitI { } < reducedExchangeI { }

-- followed by init rules
priority:
  True |- assignStepI { } < assignInitI { }
priority:
  True |- branchTrueI { } < assignInitI { }
priority:
  True |- branchFalseI { } < assignInitI { }
priority:
  True |- assignStepI { } < branchInitI { }
priority:
  True |- branchTrueI { } < branchInitI { }
priority:
  True |- branchFalseI { } < branchInitI { }
priority:
  True |- assignStepI { } < varInitI { }
priority:
  True |- branchTrueI { } < varInitI { }
priority:
  True |- branchFalseI { } < varInitI { }
priority:
  True |- assignStepP { } < assignInitP { }
priority:
  True |- branchTrueP { } < assignInitP { }
priority:
  True |- branchFalseP { } < assignInitP { }
priority:
  True |- assignStepP { } < branchInitP { }
priority:
  True |- branchTrueP { } < branchInitP { }
priority:
  True |- branchFalseP { } < branchInitP { }
priority:
  True |- assignStepP { } < varInitP { }
priority:
  True |- branchTrueP { } < varInitP { }
priority:
  True |- branchFalseP { } < varInitP { }

-- among transfer functions, order by label
priority:
    __l__ > __l__' |-
      assignStepI { __l__ = __l__ } < assignStepI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchTrueI { __l__ = __l__ } < assignStepI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchFalseI { __l__ = __l__ } < assignStepI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      assignStepI { __l__ = __l__ } < branchTrueI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchTrueI { __l__ = __l__ } < branchTrueI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchFalseI { __l__ = __l__ } < branchTrueI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      assignStepI { __l__ = __l__ } < branchFalseI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchTrueI { __l__ = __l__ } < branchFalseI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchFalseI { __l__ = __l__ } < branchFalseI { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      assignStepP { __l__ = __l__ } < assignStepP { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchTrueP { __l__ = __l__ } < assignStepP { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchFalseP { __l__ = __l__ } < assignStepP { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      assignStepP { __l__ = __l__ } < branchTrueP { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchTrueP { __l__ = __l__ } < branchTrueP { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchFalseP { __l__ = __l__ } < branchTrueP { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      assignStepP { __l__ = __l__ } < branchFalseP { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchTrueP { __l__ = __l__ } < branchFalseP { __l__ = __l__' }
priority:
    __l__ > __l__' |-
      branchFalseP { __l__ = __l__ } < branchFalseP { __l__ = __l__' }

phases: [
    * -- everything else
    , {reducedExchangeP, reducedExchangeI }
  ]

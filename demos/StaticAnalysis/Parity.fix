module StaticAnalysis.Parity where

include "Common"

```hs
joinP :: Void
joinP = undefined
```

rel StateBeforeP: Label, StateP

partial ord StateP where
  type = HashMap String Parity
  leq  = statePLeq
  mlbs = statePMlbs

rule assignInitP : Assign l _ _   |- StateBeforeP l empty
rule condInitP   : Cond l _ _ _ |- StateBeforeP l empty
rule varInitP    : Var l _        |- StateBeforeP l empty

-- actual transfer functions
rule assignStepP :
  Assign l x e, Seq l l', StateBeforeP l st, StateBeforeP l' st'
  -----------------------------------------------------------
  |- StateBeforeP l' (joinP (insertP x (evalP e st) st) st')

rule evalCondTP :
  Cond l e t _, StateBeforeP l st, StateBeforeP t st'
  ---------------------------------------------------
  |- StateBeforeP t (joinP (refineTP e st) st')

rule evalCondFP :
  Cond l e _ f, StateBeforeP l st, StateBeforeP f st'
  ---------------------------------------------------
  |- StateBeforeP f (join (refineFP e st) st')

query stateP: StateBeforeP - +

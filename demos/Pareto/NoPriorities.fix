-- Put this in benchmarks/Pareto/FixenNoPriorities.hs
module Pareto.FixenNoPriorities where

import Numeric.Natural
import Control.DeepSeq

rel DistTo : Vertex, Dist, Dist
rel Edge   : Vertex, Vertex, Dist, Dist

```hs
type Vertex = String

distMlbs :: Natural -> Natural -> [Natural]
distMlbs x y = [max x y]

instance NFData Database where
  rnf (Database x y) = rnf (x, y)

instance NFData Fact where
  rnf (DistTo x y z) = rnf (x, y, z)
  rnf (Edge a b c d) = rnf (a, b, c, d)
```

partial ord Dist where
  type = Natural -- the underlying Dist type we declared earlier
  leq  = (>=)
  mlbs = distMlbs

-- The main rule.
rule addDist: DistTo a d c, Edge a b d' c'
            |- DistTo b (d + d') (c + c')

-- interface
query distTo: DistTo + - -
query reachableIn: DistTo - + +
query distances: DistTo - - -


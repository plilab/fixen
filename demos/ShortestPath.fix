module Demos.ShortestPath where

rel DistTo : Vertex, Dist
rel Edge : Dist, Vertex, Vertex

rel Exists
```hs
type Vertex = Int

distLeq :: Int -> Int -> Bool
distLeq x y = x <= y

distMlbs :: Int -> Int -> [Int]
distMlbs x y = [(min x y)]
```

{-
partial ord Vertex where
  type = String
  leq = lol
  mlbs = lol2
-}


partial ord Dist where
  type = Int -- the underlying Dist type we declared earlier
  leq  = distLeq
  mlbs = distMlbs


-- The main rule.
rule addDist: DistTo a d, Edge d' b a
            |- DistTo b (d + d')

-- Priorities for Dijkstra's
priority:
  (d1 + d1') > (d2 + d2') 
    |- addDist { d = d1, d' = d1' } < addDist { d = d2, d' = d2' }

-- interface
query distTo: DistTo - +
query distLessThan: DistTo + -
query distances: DistTo + +



module Demos.ShortestPath where

rel DistTo : Vertex, *Dist
rel Edge : Vertex, Vertex, Dist

```hs
type Vertex = String

data Dist = D Int deriving (Show, Eq)

instance Num Dist where
  D x + D y = D (x + y)

distLeq :: Dist -> Dist -> Bool
distLeq (D x) (D y) = x <= y

distMlbs :: Dist -> Dist -> [Dist]
distMlbs (D x) (D y) = [D (min x y)]
```

partial ord Dist where
  type = Dist -- the underlying Dist type we declared earlier
  leq  = distLeq
  mlbs = distMlbs

-- The main rule.
rule addDist: DistTo a d, Edge a b d'
            |- DistTo b (d + d')

-- Priorities for Dijkstra's
priority:
  (d1 + d1') >= (d2 + d2') 
    |- addDist { d = d1, d' = d1' } <= addDist { d = d2, d' = d2' }

-- interface
query DistTo as distTo - +
query DistTo as distLessThan + -



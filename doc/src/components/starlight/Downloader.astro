---
import { Icon } from '@astrojs/starlight/components'

const { url, sum } = Astro.props;


const filename = url.replace(/^.*[\\/]/, '')
---

<a href={url} download>
  <div class="download-box">
    <div style="min-width: 2em;">
      <Icon name="download" size="2em" />
    </div>
    <div style="overflow-wrap: break-word; text-wrap: wrap; width: inherit; margin-left: 1em; margin-top: 0em;">
      <p>
        <span style="font-weight: bold;">Download</span>: {filename}
      </p>
      <p style="line-height: 1ex; margin-top: 0.5ex;">
        <span style="font-size: 0.7em;">SHA-256: <span style="font-family: 'Geist Mono Variable';">{sum}</span></span>
      </p>
    </div>
  </div>
</a>

<style>
  a {
    text-decoration: none;
    color: var(--sl-color-white);
  }

  .download-box {
    display: flex;
    align-items: center;
    padding: 1em;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-left: 0.5em solid var(--sl-color-accent-low);
    margin-top: 1em;
    margin-bottom: 1em;
    width: 100%;
  }

  .download-box:hover {
    color: var(--sl-color-accent-high);
    border-left: 0.5em solid var(--sl-color-accent);
  }

</style>

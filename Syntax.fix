-- generate exactly what the user wants. user specifies
-- 1. rules
-- 2. code blocks
-- relations are included automatically whenever 
generate Demos.ShortestPath 
  hiding (assignI, condITrue, condIFalse)
  -- alternative
  (reducedProductAssign, distTo, code, distDef)
  -- with export list -- TO DO NEXT TIME
  exporting (Abc(..),(<=),main)

-- haskell imports. imports need to be lifted to Mozzarella because we need to be able
-- to resolve them from other mozzarella files and make sure there are no duplicates;
-- or at the very least, to not include the imports of other Mozzarella files when 
-- they are used. Unconditionally included when generating haskell from this source,
-- never included when `used` by other Mozzarella files (otherwise, users cannot control
-- unused imports!
import MyStuff

/-
Block Comments!
-/

-- Haskell blocks. These should be named so that they can be omitted from imports
-- . Unnamed haskell blocks can also be written, which will then be unconditionally
-- included in the generated haskell file when used.
-- in the future, we might want to distinguish haskell blocks and blocks of other
-- languages if we want to target different backends.
distDef {

data Dist = D Int | Bot deriving (Show, Eq)

}

-- use clauses import other Mozzarella files. Currently, we only import relations,
-- rules and haskell code blocks. priorities and queries should be redefined
-- since each new analysis may use completely different priorities and interfaces
use "../AbstractInterpretation/IntervalAnalysis"
  (StateBeforeI, Seq, Assign, condI, assignI) 

-- extern declarations, solely for the symbol solver to work.
extern join

-- relations. Pretty straightforward. * annotates arguments with partial orders.
rel DistTo : Vertex, *Dist

rel Edge : Vertex, Vertex, Dist

-- rules. Pretty straightforward
rule addDist: 
  DistTo a d, Edge a b d'
  |- DistTo b (d + d')

-- rule composition. should hardly be used since the consequence
-- of the composed rule can just be listed as a premise. However,
-- useful if we want to post-compose a rule and hide the composed
-- rule from the analysis, or if you want a naive form of provenance
-- tracking
rule reducedProduct l int p:  

  (assignI, condITrue, condIFalse) { .. |- StateBeforeInterval l int }, 
  StateBeforeParity l p
  |- StateBeforeI l (narrowInterval p int)

-- higher-order rules. can receive rules as parameters. next time.
rule family reducedProductS @r l int p:  

  @r { .. |- StateBeforeInterval l int }, 
  StateBeforeParity l p
  |- StateBeforeI l (narrowInterval p int)

-- higher-order rule instantiation. next time
rule instance reducedProductAssign = reducedProductS @assignI
rule instance reducedProductCond   = reducedProductS @condITrue
rule instance reducedProductCondF  = reducedProductS @condIFalse

-- priority declarations for this exported module.
priority:
  a <= a' |- addDist { a = a } <= addDist { a = a' }

  |- addDist { } <= assignI { }

-- queries for this exported module.
query DistTo as distTo - +
query DistTo as distLessThan + -


